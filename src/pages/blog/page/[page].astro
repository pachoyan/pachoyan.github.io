---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	const PAGE_SIZE = 9;
	const allPosts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	const regularPosts = allPosts.slice(1);
	const totalPages = Math.ceil(regularPosts.length / PAGE_SIZE);

	return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, i) => {
		const page = i + 2;
		const start = (page - 2) * PAGE_SIZE;
		const posts = regularPosts.slice(start, start + PAGE_SIZE);
		return {
			params: { page: String(page) },
			props: { posts, page, totalPages },
		};
	});
}

const { posts, page, totalPages } = Astro.props;
const prevHref = page === 2 ? '/blog/' : `/blog/page/${page - 1}/`;
const nextHref = page < totalPages ? `/blog/page/${page + 1}/` : null;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} - Page ${page}`} description={SITE_DESCRIPTION} />
		<style>
			main { width: 920px; }
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li { width: calc(50% - 1rem); }
			ul li * { text-decoration: none; transition: 0.2s ease; }
			ul li img {
				display: block;
				width: 100%;
				height: 210px;
				object-fit: cover;
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a { display: block; }
			.title { margin: 0; color: rgb(var(--black)); line-height: 1; }
			.date { margin: 0; color: rgb(var(--gray)); }
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 0.45rem;
			}
			.tags span {
				font-size: 0.75rem;
				padding: 0.1rem 0.5rem;
				border-radius: 999px;
				background: rgba(var(--gray-light), 0.75);
			}
			ul li a:hover h4,
			ul li a:hover .date { color: rgb(var(--accent)); }
			ul a:hover img { box-shadow: var(--box-shadow); }
			.pager {
				display: flex;
				justify-content: space-between;
				margin-top: 1rem;
			}
			.pager a {
				padding: 0.35rem 0.8rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				text-decoration: none;
			}
			@media (max-width: 720px) {
				ul { gap: 0.5em; }
				ul li { width: 100%; text-align: center; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && <img src={post.data.heroImage} alt="" loading="lazy" />}
								<h4 class="title">{post.data.title}</h4>
								<p class="date"><FormattedDate date={post.data.pubDate} /></p>
								{post.data.tags && post.data.tags.length > 0 && (
									<p class="tags">
										{post.data.tags.map((tag) => (
											<span>{tag}</span>
										))}
									</p>
								)}
							</a>
						</li>
					))}
				</ul>
				<nav class="pager" aria-label="Blog pagination">
					<a href={prevHref}>Previous</a>
					{nextHref ? <a href={nextHref}>Next</a> : <span></span>}
				</nav>
			</section>
		</main>
		<Footer />
	</body>
</html>
