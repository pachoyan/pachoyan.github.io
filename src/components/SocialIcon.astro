}

{
	name === "dailydev" && (
		<svg viewBox="0 0 32 32" aria-hidden="true" width={size} height={size}>
			<rect x="4" y="4" width="24" height="24" rx="6" fill="currentColor"></rect>
			<path d="M11 9h10v14H11z" fill="#fff"></path>
			<path d="M13 11h6v2h-6zm0 4h6v2h-6zm0 4h4v2h-4z" fill="currentColor"></path>
		</svg>
