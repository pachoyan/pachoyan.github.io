{
	name === "medium" && (
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1770 1000" width={size} height={size} aria-hidden="true">
			<circle cx="500" cy="500" r="500" fill="currentColor"></circle>
			<ellipse cx="1296" cy="500" rx="250" ry="475" fill="currentColor"></ellipse>
			<ellipse cx="1682" cy="500" rx="88" ry="424" fill="currentColor"></ellipse>
		</svg>
	)
}

{
	name === "stackoverflow" && (
		<svg viewBox="0 0 24 24" aria-hidden="true" width={size} height={size}>
			<path
				fill="currentColor"
				d="M15.6 21.6v-6h2.4v8.4H3V15.6h2.4v6zM7.8 19.2h7.2v-2.4H7.8zm.5-5.5l7 .5.2-2.4-7-.5zm1.4-4.8l6.8 1.4.5-2.3-6.8-1.4zm2.1-4.6l6.3 3 .9-2.2-6.3-3zm4.1-3.3l-2 1.4 4 5.7 2-1.4z"
